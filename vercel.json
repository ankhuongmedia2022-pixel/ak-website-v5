{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/dich-vu",
      "destination": "/services.html"
    },
    {
      "source": "/du-an",
      "destination": "/projects.html"
    },
    {
      "source": "/gioi-thieu",
      "destination": "/about.html"
    },
    {
      "source": "/lien-he",
      "destination": "/contact.html"
    },
    {
      "source": "/agency",
      "destination": "/agency.html"
    },
    {
      "source": "/ai-shop",
      "destination": "/ai-shop.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}