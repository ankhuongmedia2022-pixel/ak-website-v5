{
  "cleanUrls": false,
  "rewrites": [
    {"source": "/dich-vu", "destination": "/services.html"},
    {"source": "/du-an", "destination": "/projects.html"},
    {"source": "/gioi-thieu", "destination": "/about.html"},
    {"source": "/lien-he", "destination": "/contact.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
    ]}
  ]
}